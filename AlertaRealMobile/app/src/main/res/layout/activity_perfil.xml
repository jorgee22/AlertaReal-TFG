<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1628">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0F1E35"
        android:paddingTop="40dp">

        <TextView
            android:id="@+id/tvAvatarPerfil"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#F0F4F8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:background="@drawable/avatar_circular"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvNombrePerfilPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invitado"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRolPerfilPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin sesión"
            android:textColor="#8BA4BE"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvBadgePerfilPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VISITANTE"
            android:textColor="#F0F4F8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/filtro_inactivo"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#0F1E35"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información de cuenta"
                        android:textColor="#F0F4F8"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nombre"
                            android:textColor="#8BA4BE"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvDatoNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#F0F4F8"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1E3A5F" android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rol"
                            android:textColor="#8BA4BE"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvDatoRol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#F0F4F8"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1E3A5F" android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:id="@+id/filaCuerpo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cuerpo"
                            android:textColor="#8BA4BE"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvDatoCuerpo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#F0F4F8"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/btnCerrarSesionPerfil"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cerrar sesión"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_rojo"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>