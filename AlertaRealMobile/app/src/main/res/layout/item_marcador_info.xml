<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/barra_busqueda"
    android:padding="14dp">

    <!-- Nivel de peligro -->
    <LinearLayout
        android:id="@+id/layoutNivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/filtro_activo"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvNivelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● ALTO"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>
    </LinearLayout>

    <!-- Tipo delito -->
    <TextView
        android:id="@+id/tvTipoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Robo con fuerza"
        android:textColor="#1A237E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <!-- Dirección -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvDireccionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calle Mayor, Madrid"
            android:textColor="#546E7A"
            android:textSize="12sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Hora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:text="🕐"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvHoraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14:05"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Botón ver detalle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Ver detalle →"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/btn_azul"/>

</LinearLayout>