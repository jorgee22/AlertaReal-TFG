<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1E35">

    <!-- Header con usuario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F1E35"
        android:padding="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvAvatarInicial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="?"
            android:textColor="#F0F4F8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/badge_blanco"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvNombrePerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invitado"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRolPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin sesión iniciada"
            android:textColor="#8BA4BE"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvBadgeRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VISITANTE"
            android:textColor="#F0F4F8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/badge_blanco"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Ciudades de España -->
            <LinearLayout
                android:id="@+id/navCiudades"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="🏙️"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ciudades de España"
                    android:textColor="#8BA4BE"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Mapa de calor -->
            <LinearLayout
                android:id="@+id/navMapaCalor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mapa de calor"
                    android:textColor="#8BA4BE"
                    android:textSize="14sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#1E3A5F"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>

            <!-- Estadísticas -->
            <LinearLayout
                android:id="@+id/navEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estadísticas"
                    android:textColor="#8BA4BE"
                    android:textSize="14sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#1E3A5F"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>

            <!-- Configuración -->
            <LinearLayout
                android:id="@+id/navConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configuración"
                    android:textColor="#8BA4BE"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Acerca de -->
            <LinearLayout
                android:id="@+id/navAcercaDe"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acerca de AlertaReal"
                    android:textColor="#8BA4BE"
                    android:textSize="14sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="v1.0 — AlertaReal TFG"
        android:textColor="#CFD8DC"
        android:textSize="11sp"/>

</LinearLayout>